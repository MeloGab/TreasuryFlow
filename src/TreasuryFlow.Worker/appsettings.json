{
  "ConnectionStrings": {
    "TreasuryFlow": ""
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "127.0.0.1",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "ExchangeName": "treasuryflow.payment-orders",
    "QueueName": "treasuryflow.payment-orders.processing",
    "SubmittedRoutingKey": "payment-order.submitted",
    "RetryExchangeName": "treasuryflow.payment-orders.retry",
    "RetryQueueName": "treasuryflow.payment-orders.processing.retry",
    "RetryRoutingKey": "payment-order.submitted.retry",
    "FailedExchangeName": "treasuryflow.payment-orders.failed",
    "FailedQueueName": "treasuryflow.payment-orders.processing.failed",
    "FailedRoutingKey": "payment-order.submitted.failed",
    "BatchSize": 20,
    "PollingIntervalSeconds": 5,
    "RetryDelaySeconds": 30,
    "ConsumerRetryDelaySeconds": 5,
    "ConsumerMaximumRetryAttempts": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
